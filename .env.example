# uitars-mcp — environment variables
#
# Copy this file to .env and fill in your values.
# The server works with default values for local VLM.

# Port for the main uvicorn server (REST + MCP + webapp)
# UITARS_PORT=10976

# Port for the Vite dev server (webapp development)
# UITARS_FRONTEND_PORT=10977

# VLM provider — any OpenAI-compatible /v1/chat/completions endpoint
# UITARS_VLM_BASE_URL=http://127.0.0.1:11434/v1
# UITARS_VLM_MODEL=llama3.2-vision:11b

# VLM API key (only needed for cloud providers)
# UITARS_VLM_API_KEY=

# Maximum action steps per task
# UITARS_MAX_STEPS=15
